# Copy this file to .env and fill in your own values. Never commit .env.

# Secret used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-long-random-string

# SerpApi key (Google Flights engine) from https://serpapi.com.
# Leave blank to use mock price data.
SERPAPI_KEY=

# Google Gemini API key from https://aistudio.google.com (free tier available).
# Leave blank to use mock AI recommendations.
GEMINI_API_KEY=

# Gemini model used for recommendations. Defaults to gemini-3.8-flash if blank.
GEMINI_MODEL=gemini-3.8-flash

# Set to true to skip Gemini and return sample recommendations (no key or quota needed).
AI_MOCK=true

# Set to true to skip SerpApi and return sample flight prices (no key or quota needed).
PRICE_MOCK=true
